.site-footer { background: rgb(58, 31, 18); color: rgb(243, 234, 216); padding: 48px 0px 24px; margin-top: 24px; }

.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 24px; }

.site-footer a:hover { text-decoration: underline; }

.copyright { margin-top: 28px; padding-top: 16px; border-top: 1px solid rgba(243, 234, 216, 0.2); font-size: 14px; }

.empty { padding: 48px; text-align: center; background: var(--color-card); border: 1px dashed var(--color-border); border-radius: var(--radius); }

.mobile-nav { display: none; }

@media (max-width: 1024px) {
  .product-grid, .product-grid.four, .review-grid, .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .feature-grid, .video-grid { grid-template-columns: repeat(2, 1fr); }
  .hero-grid, .pdp, .about-grid, .cart-layout, .band .wrap, .footer-grid, .why-grid { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .nav { display: none; }
  .menu-toggle { display: grid; }
  .mobile-nav.open { display: grid; gap: 8px; padding: 8px 16px 16px; }
  .mobile-nav a { min-height: 44px; display: flex; align-items: center; padding: 0px 8px; }
  .product-grid, .product-grid.four, .feature-grid, .review-grid, .video-grid, .gallery-grid { grid-template-columns: 1fr; }
  .hero-media { grid-template-columns: 1fr 1fr; grid-template-rows: 180px 140px; }
  .cart-item { grid-template-columns: 72px 1fr; }
  .cart-item .line-total { grid-column: 2; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, ::before, ::after { animation: auto ease 0s 1 normal none running none !important; transition: none !important; }
}
